{
  "name": "puntosolarmexico",
  "version": "1.0.0",
  "private": true,
  "description": "Sitio web de Punto Solar México con Node.js y Express",
  "packageManager": "pnpm@11.1.2",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "vite",
    "dev:server": "node --watch server.js",
    "build": "node --check server.js && vite build",
    "test": "pnpm build && node --test"
  },
  "dependencies": {
    "@fontsource/roboto": "5.3.0",
    "express": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5"
  }
}
